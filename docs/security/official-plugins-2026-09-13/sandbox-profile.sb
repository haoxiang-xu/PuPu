(version 1)
(deny default)
(allow process*)
(allow sysctl-read)
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/Library/Apple"))
(allow file-read* (subpath "/Users/red/.local/share/uv/python/cpython-3.12.11-macos-aarch64-none"))
(allow file-read* (subpath "/Users/red/Desktop/GITRepo/unchain/.venv"))
(allow file-read* (subpath "/private/tmp/pupu-official-verify-mj1zxup1"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/dev"))
(allow file-write* (subpath "/private/tmp/pupu-official-verify-mj1zxup1/sandbox"))
(allow file-write* (literal "/dev/null"))
