          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file inside the workspace roots."
            },
            "offset": {
              "type": "integer",
              "description": "Zero-based line offset to start reading from."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of lines to return. Omit for the full file."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "function",
