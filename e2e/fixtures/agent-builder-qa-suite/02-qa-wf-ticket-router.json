{"content_digest":"5e685c44e2ef29e2365534c38570282726ad1e5de5113bbd9efd54fa67ca8670","contents":[{"sha256":"21fed500866219e11feb25a8acfc39a5ec7f20d759680587c6183197b9cb6449","text":"def main(input, context):\n    amount = float(input[\"amount\"] or 0)\n    team = \"finance-senior\" if amount >= 1000 else \"finance\"\n    return {\"team\": team, \"sla_hours\": 4 if amount >= 1000 else 24,\n            \"next_step\": \"核对订单与扣款记录，确认是否走退款流程\"}\n"},{"sha256":"687eba48f7beac5f90ed268e363c1a2aa1631765c405870af6e1f6b49bbb884a","text":"def main(input, context):\n    return {\"team\": \"support\", \"sla_hours\": 24, \"next_step\": \"人工阅读后再分类\"}\n"},{"sha256":"7f2513c70da6cd849e3f2a8ba3cabbd8fab7ea1cb21f409dd10ab9c798dd6cfe","text":"import re\n\nRULES = {\n    \"billing\": [\"refund\", \"invoice\", \"charge\", \"退款\", \"发票\", \"扣费\", \"账单\", \"付款\"],\n    \"bug\": [\"error\", \"crash\", \"bug\", \"broken\", \"报错\", \"崩溃\", \"闪退\", \"无法\", \"打不开\"],\n    \"feature\": [\"feature\", \"support for\", \"would be nice\", \"希望\", \"建议\", \"能不能\", \"新增\"],\n}\nURGENT = [\"urgent\", \"asap\", \"immediately\", \"紧急\", \"马上\", \"尽快\", \"生产环境\", \"全部用户\"]\n\n\ndef main(input, context):\n    title = input[\"title\"].strip()\n    body = input[\"body\"].strip()\n    tier = (input[\"customer_tier\"] or \"standard\").lower()\n    amount = float(input[\"amount\"] or 0)\n    text = (title + \"\\n\" + body).lower()\n    hits = {name: sum(word in text for word in words) for name, words in RULES.items()}\n    category = max(hits, key=hits.get) if max(hits.values()) > 0 else \"other\"\n    signals = [f\"{name}:{count}\" for name, count in hits.items() if count]\n    score = 20 + 15 * hits.get(category, 0)\n    if any(word in text for word in URGENT):\n        score += 30\n        signals.append(\"urgent\")\n    if tier == \"enterprise\":\n        score += 20\n        signals.append(\"enterprise\")\n    if amount >= 1000:\n        score += 15\n        signals.append(\"amount>=1000\")\n    if re.search(r\"!{2,}|！{2,}\", title + body):\n        score += 5\n    return {\"category\": category, \"priority_score\": min(score, 100), \"signals\": signals, \"tier\": tier}\n"},{"sha256":"ad3b899ebbfd9d464ffb23da6c919ab741e65e9c8983e2860c7a3a83eac51458","text":"def main(input, context):\n    return {\"team\": \"product\", \"sla_hours\": 120, \"next_step\": \"记录需求并合并到需求池，回复用户已收到\"}\n"},{"sha256":"b381486b3b3e7e6182a13e847f5cc06067b73f0e90f1d36a01048681e1b6085d","text":"def main(input, context):\n    reasons = list(input[\"signals\"])\n    return {\"team\": \"escalation-desk\", \"sla_hours\": 1,\n            \"next_step\": \"升级给值班主管：\" + \"、\".join(reasons or [\"高优先级\"]),\n            \"original_team\": input[\"team\"]}\n"},{"sha256":"f69c6b1244abf107131e6c213b35abf73cbffd592c627877eb6ad25eeb1f6616","text":"def main(input, context):\n    score = int(input[\"priority_score\"])\n    return {\"team\": \"engineering-oncall\" if score >= 70 else \"engineering\",\n            \"sla_hours\": 2 if score >= 70 else 48,\n            \"next_step\": \"收集版本号、复现步骤与日志，创建缺陷单\"}\n"}],"document":{"description":"纯规则路由：关键词打分 → Switch 四路分派（含 default）→ If/Else（any/all 组合条件）决定是否升级，End 用 first_present 汇合各分支。可选参数测默认值与 null。","edges":[{"id":"flow-start-out-score","kind":"flow","source_node_id":"start","source_port_id":"out","target_node_id":"score","target_port_id":"in"},{"id":"flow-score-out-by_category","kind":"flow","source_node_id":"score","source_port_id":"out","target_node_id":"by_category","target_port_id":"in"},{"id":"flow-by_category-case-billing-route_billing","kind":"flow","source_node_id":"by_category","source_port_id":"case-billing","target_node_id":"route_billing","target_port_id":"in"},{"id":"flow-route_billing-out-need_escalate","kind":"flow","source_node_id":"route_billing","source_port_id":"out","target_node_id":"need_escalate","target_port_id":"in"},{"id":"flow-by_category-case-bug-route_bug","kind":"flow","source_node_id":"by_category","source_port_id":"case-bug","target_node_id"