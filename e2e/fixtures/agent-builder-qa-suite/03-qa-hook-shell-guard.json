{"content_digest":"530905d20cbe126773b7b2120afc049b38efe2b33900c649f0fd37dcd80d726b","contents":[{"sha256":"04875e7e41ea5a214fdf6b30a3801e6c9bbe4b5efd06317735951613aa640093","text":"import re\n\nDANGEROUS = [\n    (r\"\\brm\\s+-[a-z]*r[a-z]*f|\\brm\\s+-[a-z]*f[a-z]*r\", \"递归强制删除\"),\n    (r\"\\bsudo\\b\", \"提权\"),\n    (r\"curl[^|]*\\|\\s*(ba)?sh|wget[^|]*\\|\\s*(ba)?sh\", \"下载即执行\"),\n    (r\"git\\s+push\\s+.*(--force|-f\\b)\", \"强推\"),\n    (r\"\\bchmod\\s+-R\\s+777\", \"全局放权\"),\n    (r\">\\s*/dev/sd|mkfs|dd\\s+if=\", \"写磁盘\"),\n]\n\n\ndef main(input, context):\n    args = input[\"arguments\"] or {}\n    command = str(args.get(\"command\") or args.get(\"cmd\") or \"\")\n    matched = [label for pattern, label in DANGEROUS if re.search(pattern, command)]\n    return {\"require_approval\": bool(matched), \"matched\": matched}\n"}],"document":{"description":"before_tool_call Hook（已发布、被引用）：rm -rf、sudo、curl|sh、强推等命令强制弹审批，其余直接放行。","edges":[{"id":"flow-start-out-inspect","kind":"flow","source_node_id":"start","source_port_id":"out","target_node_id":"inspect","target_port_id":"in"},{"id":"flow-inspect-out-end","kind":"flow","source_node_id":"inspect","source_port_id":"out","target_node_id":"end","target_port_id":"in"}],"id":"qa-hook-shell-guard","kind":"workflow","name":"QA · Hook：危险命令需审批","nodes":[{"config":{"execution":{"outputs":[{"name":"event","source":{"kind":"result","path":["event"]}},{"name":"tool_name","source":{"kind":"result","path":["tool_name"]}},{"name":"arguments","source":{"kind":"result","path":["arguments"]}}]}},"id":"start","type":"start"},{"config":{"code":{"environment_profile_id":"builtin","max_log_bytes":1048576,"max_result_bytes":1048576,"result_schema":{"additionalProperties":false,"properties":{"matched":{"items":{"type":"string"},"type":"array"},"require_approval":{"type":"boolean"}},"required":["require_approval","matched"],"type":"object"},"source":{"kind":"file","path":"__pupu_code__/sha256/04875e7e41ea5a214fdf6b30a3801e6c9bbe4b5efd06317735