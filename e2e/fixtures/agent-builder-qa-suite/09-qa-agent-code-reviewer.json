{"content_digest":"8355cdd70509c877ddadd9cf767b75b82416863f7e9fe0a449362a602bd42a47","contents":[{"sha256":"0a138f4d87f7489f100c67eeaf50d40b021b71dc56a0a2ade8c85fc10002d8c9","text":"import json, re\n\nPATTERNS = [\n    (re.compile(r\"sk-[A-Za-z0-9_-]{16,}\"), \"sk-***\"),\n    (re.compile(r\"AKIA[0-9A-Z]{16}\"), \"AKIA***\"),\n    (re.compile(r\"(?i)(password|passwd|secret|token)\\s*[:=]\\s*\\S+\"), r\"\\1=***\"),\n    (re.compile(r\"-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----\"), \"[私钥已隐去]\"),\n]\n\n\ndef scrub(value, counter):\n    if isinstance(value, str):\n        for pattern, replacement in PATTERNS:\n            value, n = pattern.subn(replacement, value)\n            counter[0] += n\n        return value\n    if isinstance(value, list):\n        return [scrub(item, counter) for item in value]\n    if isinstance(value, dict):\n        return {key: scrub(item, counter) for key, item in value.items()}\n    return value\n\n\ndef main(input, context):\n    counter = [0]\n    cleaned = scrub(input[\"visible_result\"], counter)\n    if counter[0]:\n        cleaned = dict(cleaned)\n        cleaned[\"redactions\"] = counter[0]\n    return {\"result\": cleaned}\n"},{"sha256":"69538a0a8f7d8c49a5da5f9fe990816bf6e6294a9b423744e01d4a2a3a7f4fe5","text":"def main(input, context):\n    text = input[\"report\"]\n    sections = [line for line in text.splitlines() if line.startswith(\"#\")]\n    return {\"report\": text, \"section_count\": len(sections), \"length\": len(text)}\n"},{"sha256":"6fc68d7e49f725ddaf20b338b7328553d4909f7b63ae0c172a60a19b99580c87","text":"def main(input, context):\n    found = input[\"found\"] or {}\n    ok = bool(input[\"ok\"])\n    paths = []\n    if isinstance(found, dict):\n        for key in (\"matches\", \"files\", \"paths\", \"results\"):\n            if isinstance(found.get(key), list):\n                paths = [p if isinstance(p, str) else str(p.get(\"path\", p)) for p in found[key]]\n                break\n    paths = sorted(paths, key=lambda p: (p.count(\"/\"), len(p)))[:8]\n    note = \"工作区里找到的说明文档\" if paths else (\n        \"没有列出文件（工具调用失败或工作区为空），请自行用 glob/read 查找\" if not ok else \"工作区里没有 Markdown 文件\")\n    return {\"files\": paths, \"note\": note}\n"}],"document":{"description":"Tool Call（glob，失败继续）→ Code → 审查 Agent。Agent 挂 Toolkit Pool（core 六个工具 + 一个 Workflow 工具）和 Hooks Pool：引用型 shell 审批、内嵌的写文件拦截、内嵌的结果脱敏（after_tool_call）、一个已停用的 Hook。","edges":[{"id":"flow-start-out-list_docs","kind":"flow","source_node_id":"start","source_port_id":"out","target_node_id":"list_docs","target_port_id":"in"},{"id":"flow-list_docs-out-pick","kind":"flow","source_node_id":"list_docs","source_port_id":"out","target_node_id":"pick","target_port_id":"in"},{"id":"flow-pick-out-reviewer","kind":"flow","source_node_id":"pick","source_port_id":"out","target_node_id":"reviewer","target_port_id":"in"},{"id":"flow-reviewer-out-wrap","kind":"flow","source_node_id":"reviewer","source_port_id":"out","target_node_id":"wrap","target_port_id":"in"},{"id":"flow-wrap-out-end","kind":"flow","source_node_id":"wrap","source_port_id":"out","target_node_id":"end","target_port_id":"in"},{"id":"attach-reviewer-tools","kind":"attach","source_node_id":"reviewer","source_port_id":"attach_bot","target_node_id":"tools","target_port_id":"attach_top"},{"id":"attach-reviewer-hooks","kind":"attach","source_node_id":"reviewer","source_port_id":"attach_top","target_node_id":"hooks","target_port_id":"attach_bot"}],"id":"qa-agent-code-reviewer","kind":"agent","name":"QA · 只读代码审查","nodes":[{"config":{"execution":{"outputs":[{"name":"message","source":{"kind":"result","path":["message"]}}]}},"id":"start","label":"审查要求","type":"start"},{"config":{"execution":{"inputs":[{"missing":"error","name":"pattern","value":{"kind":"literal","value":"**/*.md"}}],"outputs":[{"name":"found","source":{"kind":"result","path":["result"]}},{"name":"ok","source":{"kind":"result","path":["ok"]}}]},"tool":{"approval_timeout_ms":600000,"name":"glob","on_error":"continue"}},"id":"list_docs","label":"列出 Markdown（Tool Call）","type":"tool_call"},{"config":{"code":{"environment_profile_id":"builtin","max_log_bytes":1048576,"max_result_bytes":1048576,"result_schema":{"additionalProperties":false,"properties":{"files":{"items":{"type":"string"},"type":"array"},"note":{"type":"string"}},"required":["files","note"],"type":"object"},"source":{"kind":"file","path":"__pupu_code__/sha256/6fc68d7e49f725ddaf20b338b7328553d4909f7b63ae0c172a60a19b99580c87.py"},"timeout_ms":30000},"execution":{"inputs":[{"missing":"null","name":"found","value":{"kind":"ref","node_id":"list_docs","path":["found"]}},{"missing":"error","name":"ok","value":{"kind":"ref","node_id":"list_docs","path":["ok"]}}],"outputs":[{"name":"files","source":{"kind":"result","path":["files"]}},{"name":"note","source":{"kind":"result","path":["note"]}}]}},"id":"pick","label":"挑重点文件","type":"code"},{"config":{"execution":{"inputs":[{"missing":"error","name":"message","value":{"kind":"ref","node_id":"start","path":["message"]}},{"missing":"error","name":"files","value":{"kind":"ref","node_id":"pick","path":["files"]}},{"missing":"error","name":"note","value":{"kind":"ref","node_id":"pick","path":["note"]}}],"outputs":[{"name":"message","source":{"kind":"result","path":["message"]}},{"name":"context","source":{"kind":"result","path":["context"]}}]},"kernel":{"history":"root","json_schema":null,"max_iterations":16,"output_tokens":8192,"overflow":"error","profile":{"capabilities":{"files":true,"images":true,"json_schema":true},"context_window":1047576,"credential_ref":"openai","endpoint":"https://api.openai.com/v1","id":"openai:gpt-4.1-mini","model":"gpt-4.1-mini","output_limit":16384,"protocol":"openai-responses","provider":"openai"},"prompt":"你是只读代码审查员，工作区就是被审查的仓库。{{#input.note#}}：先看这些文件，再按用户要求用 read/grep/glob 深入。需要统计长文本时调用 workflow_text_stats 工具。可以用 shell 跑只读命令，危险命令会被要求审批。不要写文件。输出：## 结论、## 问题（按严重度）、## 建议。","schema_version":1}},"id":"reviewer","label":"审查员","type":"